{
  "info": {
    "name": "Shift Scheduler API",
    "description": "A story-driven collection testing the Shift Scheduling Engine.\n\nRun requests in order — each step builds on the previous one.\n\nPrerequisite: Start the server with `mvn spring-boot:run`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Verify Seed Data",
      "description": "Confirm the application started with seed data loaded",
      "item": [
        {
          "name": "1.1 Get Employee - Alice Johnson",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/employees/emp-01",
            "description": "Alice is a FULL_TIME SUPERVISOR with FIRST_AID, available Mon-Fri 06:00-22:00"
          }
        },
        {
          "name": "1.2 Get Employee - Bob Smith",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/employees/emp-02",
            "description": "Bob is FULL_TIME with FORKLIFT_CERTIFIED"
          }
        },
        {
          "name": "1.3 Get Shift - shf-01 (Mon 06:00-14:00)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/shifts/shf-01",
            "description": "Warehouse A, requires 2 FORKLIFT_CERTIFIED employees"
          }
        },
        {
          "name": "1.4 Get Schedule - Week of 2026-03-30",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/schedules/sch-01",
            "description": "Contains all 5 shifts for the week"
          }
        },
        {
          "name": "1.5 List Shifts for Schedule",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/shifts?scheduleId=sch-01",
            "description": "All 5 shifts belonging to sch-01"
          }
        }
      ]
    },
    {
      "name": "2. Valid Assignments",
      "description": "Assign qualified employees to shifts — these should all succeed with 201",
      "item": [
        {
          "name": "2.1 Assign Bob to shf-01 (FORKLIFT shift)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"emp-02\",\n  \"shiftId\": \"shf-01\"\n}"
            },
            "description": "Bob has FORKLIFT_CERTIFIED → should pass skill check"
          }
        },
        {
          "name": "2.2 Assign Alice to shf-03 (SUPERVISOR shift)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"emp-01\",\n  \"shiftId\": \"shf-03\"\n}"
            },
            "description": "Alice has SUPERVISOR → should pass skill check"
          }
        },
        {
          "name": "2.3 Assign David to shf-01 (fill headcount)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"emp-04\",\n  \"shiftId\": \"shf-01\"\n}"
            },
            "description": "David has FORKLIFT_CERTIFIED → shf-01 now has 2/2 headcount"
          }
        }
      ]
    },
    {
      "name": "3. Scenario A - OVERLAP Violation",
      "description": "Assign emp-01 to shf-01 (Mon 06:00-14:00) — she's already on shf-03 (Mon 08:00-16:00)",
      "item": [
        {
          "name": "3.1 Attempt: Alice → shf-01 (overlaps with shf-03)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"emp-01\",\n  \"shiftId\": \"shf-01\"\n}"
            },
            "description": "EXPECTED: 400 with OVERLAP violation.\nAlice is already on shf-03 (08:00-16:00) which overlaps shf-01 (06:00-14:00)"
          }
        }
      ]
    },
    {
      "name": "4. Scenario B - REST_VIOLATION",
      "description": "Assign emp-02 to shf-04 (Tue 06:00-14:00) — he finishes shf-02 Mon 22:00, only 8h rest",
      "item": [
        {
          "name": "4.1 Assign Bob to shf-02 (Mon 14:00-22:00)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"emp-02\",\n  \"shiftId\": \"shf-02\"\n}"
            },
            "description": "Setup: assign Bob to the evening shift"
          }
        },
        {
          "name": "4.2 Attempt: Bob → shf-04 (only 8h rest)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"emp-02\",\n  \"shiftId\": \"shf-04\"\n}"
            },
            "description": "EXPECTED: 400 with REST_VIOLATION.\nBob finishes shf-02 at Mon 22:00, shf-04 starts Tue 06:00 = only 8h rest (need 11)"
          }
        }
      ]
    },
    {
      "name": "5. Scenario C - SKILL_MISMATCH",
      "description": "Assign emp-03 (FIRST_AID only) to shf-01 (requires FORKLIFT_CERTIFIED)",
      "item": [
        {
          "name": "5.1 Attempt: Carol → shf-01 (missing FORKLIFT)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"emp-03\",\n  \"shiftId\": \"shf-01\"\n}"
            },
            "description": "EXPECTED: 400 with SKILL_MISMATCH.\nCarol only has FIRST_AID, shift requires FORKLIFT_CERTIFIED"
          }
        }
      ]
    },
    {
      "name": "6. Scenario D - UNDERSTAFFED (conflicts endpoint)",
      "description": "Check conflicts — shf-02, shf-04, shf-05 are still understaffed",
      "item": [
        {
          "name": "6.1 Get Conflicts for sch-01",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/schedules/sch-01/conflicts",
            "description": "EXPECTED: UNDERSTAFFED warnings for shifts that don't have enough employees"
          }
        }
      ]
    },
    {
      "name": "7. Scenario E - AVAILABILITY_VIOLATION",
      "description": "Create a Saturday shift and try to assign emp-01 (Mon-Fri only)",
      "item": [
        {
          "name": "7.1 Create Saturday shift",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/shifts",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": \"Office\",\n  \"startDatetime\": \"2026-04-04T08:00:00\",\n  \"endDatetime\": \"2026-04-04T16:00:00\",\n  \"requiredHeadcount\": 1,\n  \"requiredSkills\": [\"SUPERVISOR\"]\n}"
            },
            "description": "Create a new shift on Saturday — note the returned shift ID"
          }
        },
        {
          "name": "7.2 Create a new schedule including Saturday shift",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weekend Schedule\",\n  \"startDate\": \"2026-04-04\",\n  \"endDate\": \"2026-04-05\",\n  \"shiftIds\": []\n}"
            },
            "description": "NOTE: You'll need to manually add the Saturday shift ID from step 7.1 to this schedule's shiftIds, or create the schedule with the shift ID included"
          }
        }
      ]
    },
    {
      "name": "8. Auto-Assign",
      "description": "Let the system automatically fill remaining shifts",
      "item": [
        {
          "name": "8.1 Auto-assign employees to sch-01",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/sch-01/auto-assign",
            "description": "The system will assign qualified, available employees to understaffed shifts respecting all 6 rules"
          }
        },
        {
          "name": "8.2 Check conflicts after auto-assign",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/schedules/sch-01/conflicts",
            "description": "EXPECTED: Fewer UNDERSTAFFED warnings (ideally none if enough qualified employees exist)"
          }
        }
      ]
    },
    {
      "name": "9. Cleanup - Remove Assignment",
      "description": "Demonstrate removing an assignment",
      "item": [
        {
          "name": "9.1 Remove Bob from shf-01",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/schedules/sch-01/assign?employeeId=emp-02&shiftId=shf-01",
            "description": "EXPECTED: 204 No Content"
          }
        }
      ]
    },
    {
      "name": "10. Employee Schedule View",
      "description": "View an employee's assigned shifts for a specific week",
      "item": [
        {
          "name": "10.1 Get Alice's schedule for W14",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/employees/emp-01/schedule?week=2026-W14",
            "description": "Returns all shifts Alice is assigned to in ISO week 14 (week of 2026-03-30)"
          }
        }
      ]
    }
  ]
}
